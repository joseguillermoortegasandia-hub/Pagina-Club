# ===== Supabase (obligatorio en producción) =====
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxx

# El club que se utiliza en localhost o si el dominio no está mapeado.
NEXT_PUBLIC_DEFAULT_CLUB_SLUG=club-deportivo

# ===== Mux (solo servidor; NO usar NEXT_PUBLIC_) =====
MUX_TOKEN_ID=xxxxxxxxx
MUX_TOKEN_SECRET=xxxxxxxxx
MUX_WEBHOOK_SIGNING_SECRET=xxxxxxxxx

# URL pública de producción, sin slash al final.
NEXT_PUBLIC_APP_URL=https://tu-dominio.com

# Modo demo: true permite recorrer la interfaz sin Supabase.
# En producción DEBE ser false.
NEXT_PUBLIC_DEMO_MODE=true
